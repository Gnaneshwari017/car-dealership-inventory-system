# Database Connection URL (PostgreSQL for production/Docker, SQLite fallback for quick local testing)
# PostgreSQL Example: postgresql://postgres:postgres@localhost:5432/dealership_db
# SQLite Example: sqlite:///./dealership.db
DATABASE_URL=sqlite:///./dealership.db

# JWT Security Configuration
JWT_SECRET=generate-a-secure-random-256-bit-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated list or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Server Environment
ENVIRONMENT=development
PROJECT_NAME="Apex Motors Car Dealership Inventory API"
API_V1_PREFIX=/api
